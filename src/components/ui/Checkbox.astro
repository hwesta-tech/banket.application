---
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  label?: string;
  checked?: boolean;
  required?: boolean;
  type?: 'checkbox' | 'toggle';
  /** Aviso mostrado junto da caixa quando um checkbox obrigatório não foi marcado no envio */
  mensagemObrigatorio?: string;
}

const {
  id,
  name,
  label = '',
  checked = false,
  required = false,
  type = 'checkbox',
  mensagemObrigatorio = 'Marque esta opção para continuar.',
} = Astro.props;
const idErro = `${id}-erro`;
---

<div class={`checkbox-group type-${type}`}>
  <label class="checkbox-label" for={id}>
    {type === 'toggle' ? (
      <div class="toggle-wrapper">
        <input type="checkbox" id={id} name={name} class="toggle-input" checked={checked} />
        <div class="toggle-slider"></div>
      </div>
    ) : (
      <div class="checkbox-wrapper">
        <input
          type="checkbox"
          id={id}
          name={name}
          class="checkbox-input"
          checked={checked}
          required={required}
          data-mensagem-obrigatorio={required ? mensagemObrigatorio : undefined}
          aria-describedby={required ? idErro : undefined}
        />
        <div class="checkbox-box">
          <Icon name="check" size={13} stroke={2.5} class="checkmark" />
        </div>
      </div>
    )}
    <span class="label-text">{Astro.slots.has('default') ? <slot /> : label}</span>
  </label>
  {required && type === 'checkbox' && <p class="field-erro checkbox-erro" id={idErro} role="alert" hidden></p>}
</div>

<script>
  // O input real é visualmente oculto, então o navegador bloqueia o envio sem mostrar o balão de validação.
  // O aviso aparece junto da caixa desenhada e some ao marcar.
  document.addEventListener(
    'invalid',
    (e) => {
      const campo = e.target;
      if (!(campo instanceof HTMLInputElement) || !campo.classList.contains('checkbox-input')) return;
      const erro = campo.closest('.checkbox-group')?.querySelector<HTMLElement>('.checkbox-erro');
      if (!erro) return;
      e.preventDefault();
      erro.textContent = campo.dataset.mensagemObrigatorio || 'Marque esta opção para continuar.';
      erro.hidden = false;
      campo.setAttribute('aria-invalid', 'true');
      // Só o primeiro campo inválido do formulário recebe o foco
      const primeiro = campo.form?.querySelector(':invalid');
      if (primeiro === campo) campo.focus();
    },
    true
  );
  document.addEventListener('change', (e) => {
    const campo = e.target;
    if (!(campo instanceof HTMLInputElement) || !campo.classList.contains('checkbox-input') || !campo.checked) return;
    const erro = campo.closest('.checkbox-group')?.querySelector<HTMLElement>('.checkbox-erro');
    if (erro) erro.hidden = true;
    campo.removeAttribute('aria-invalid');
  });
</script>

<style>
  .checkbox-group {
    margin-bottom: var(--space-4);
  }

  .checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    user-select: none;
  }

  .type-toggle .checkbox-label {
    gap: var(--space-2-5);
  }

  .label-text {
    font-size: var(--fs-14);
    color: var(--text-body);
  }

  /* 1px (não 0): o campo continua focável e participa da validação do formulário */
  .checkbox-input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    width: 1px;
    height: 1px;
  }

  .checkbox-input[aria-invalid='true'] ~ .checkbox-box {
    border-color: var(--danger);
  }

  .checkbox-erro {
    margin-top: var(--space-1-5);
  }

  .checkbox-wrapper {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }

  .checkbox-box {
    width: 100%;
    height: 100%;
    background-color: var(--bg-surface);
    border: 1.5px solid var(--border-strong);
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .checkbox-label:hover .checkbox-box {
    border-color: var(--clay-500);
  }

  .checkmark {
    opacity: 0;
  }

  .checkbox-input:checked ~ .checkbox-box {
    background-color: var(--action-primary);
    border-color: var(--action-primary);
  }

  /* O input real fica invisível: o foco aparece na caixa desenhada */
  .checkbox-input:focus-visible ~ .checkbox-box,
  .toggle-input:focus-visible ~ .toggle-slider {
    box-shadow: var(--focus-ring-forte);
  }

  .checkbox-input:checked ~ .checkbox-box .checkmark {
    opacity: 1;
  }

  .toggle-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-wrapper {
    position: relative;
    flex: none;
    width: 36px;
    height: 20px;
  }

  .toggle-slider {
    position: absolute;
    inset: 0;
    cursor: pointer;
    background-color: var(--clay-300);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-inset);
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .toggle-slider:before {
    position: absolute;
    content: '';
    height: 16px;
    width: 16px;
    left: 2px;
    top: 2px;
    background-color: #fff;
    border-radius: 50%;
    box-shadow: 0 1px 2px rgba(36, 29, 25, 0.25);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .toggle-input:checked ~ .toggle-slider {
    background-color: var(--terracotta-500);
  }

  .toggle-input:checked ~ .toggle-slider:before {
    transform: translateX(16px);
  }
</style>
